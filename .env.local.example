# From Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# New Supabase dashboard shows a "publishable" key (preferred).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy name still works if you only have the old anon JWT:
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required for client portal when using Supabase (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: cookie signing secret for portal sessions
# OUTPOST_PORTAL_SECRET=long-random-string

# Optional: keep using local JSON files instead of Supabase (dev only)
# OUTPOST_USE_FILE_STORE=1

# Public inbound API (website contact form → /api/leads/inbound)
# Shared secret — same value as OUTPOST_INGEST_SECRET on timblazic.dev
OUTPOST_INGEST_SECRET=long-random-shared-secret
# Optional: owner id for inbound leads (defaults to u1 / your profile id)
# OUTPOST_DEFAULT_OWNER_ID=u1

# Split hosts (same Vercel project, two domains)
# admin.* = studio CRM · client.* = client portal
NEXT_PUBLIC_ADMIN_URL=https://admin.timblazic.dev
NEXT_PUBLIC_PORTAL_URL=https://client.timblazic.dev
# Optional overrides if hostnames differ from the URLs above
# NEXT_PUBLIC_ADMIN_HOST=admin.timblazic.dev
# NEXT_PUBLIC_PORTAL_HOST=client.timblazic.dev

# AI lead email (Anthropic Claude Sonnet)
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5
