# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep *.example templates in git)
.env*
!.env.example
!.env*.example

# vercel
.vercel

# Tauri desktop build artifacts
/desktop/src-tauri/target/
/desktop/node_modules/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local file-based data store (seeded at runtime)
/data

# One-off Harvey export dumps (root)
/invoices.json
/customers.json
