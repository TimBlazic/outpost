{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outpost",
  "version": "0.1.0",
  "identifier": "dev.timblazic.outpost",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Business",
    "shortDescription": "Outpost studio CRM",
    "longDescription": "Desktop shell for the Outpost studio CRM at admin.timblazic.dev.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
